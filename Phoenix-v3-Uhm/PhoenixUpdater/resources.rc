        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Enveart Di Ferrara Mauro"
            VALUE "FileDescription",  "PhoenixAC Updater"
            VALUE "FileVersion",      "1.1.0.0"
            VALUE "InternalName",     "Updater"
            VALUE "OriginalFilename", "Updater.exe"
            VALUE "ProductName",      "PhoenixAC"
            VALUE "ProductVersion",   "1.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

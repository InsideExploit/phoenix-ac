  <Target Name="DiagOllvmPath" BeforeTargets="ClCompile">
    <Message Importance="high" Text="[OLLVM/diag] OllvmClangCL = $(OllvmClangCL)" />
    <Message Importance="high" Text="[OLLVM/diag] Exists() at target-time = $([System.IO.File]::Exists('$(OllvmClangCL)'))" />
  </Target>
  <Target Name="PhoenixEnvBanner" BeforeTargets="ClCompile">
    <Message Importance="high" Text="[Phoenix/Updater] KG_ENV_LOCAL=$(PhoenixEnvLocal), EnableOllvm=$(EnableOllvm)" />
  </Target>
  <Target Name="ApplyOllvmCompiler" BeforeTargets="ClCompile" Condition="'$(EnableOllvm)'=='true' AND Exists('$(OllvmClangCL)')">
    <Message Importance="high" Text="[OLLVM] using $(OllvmClangCL) with passes: $(OllvmPasses)" />
    <PropertyGroup>
      <CLToolExe>clang-cl.exe</CLToolExe>
      <CLToolPath>$(OllvmBin)</CLToolPath>
    </PropertyGroup>
    <ItemGroup>
      <ClCompile>
        <AdditionalOptions>%(ClCompile.AdditionalOptions) $(OllvmCompatFlags) $(OllvmPasses)</AdditionalOptions>
      </ClCompile>
    </ItemGroup>
  </Target>
  <Target Name="WarnOllvmMissing" BeforeTargets="ClCompile" Condition="'$(EnableOllvm)'=='true' AND !Exists('$(OllvmClangCL)')">
